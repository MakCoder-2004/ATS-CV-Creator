{
  "name": "cv-tailor",
  "private": true,
  "version": "0.2.2",
  "description": "CV Tailor personal Windows workbench",
  "author": "CV Tailor",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "workspaces": [
    "prototypes/cv-tailor-ui"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm rebuild better-sqlite3 --no-audit --no-fund && vitest run",
    "test:fast": "vitest run",
    "test:electron": "npm run build && electron-rebuild -f -w better-sqlite3 && playwright test",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "verify:electron-sqlite": "node scripts/verify-electron-sqlite.cjs",
    "prepare:latex": "node scripts/prepare-latex.cjs",
    "verify:latex": "node scripts/verify-latex.cjs --smoke",
    "dist:win": "npm run verify:latex && npm run build && npm run rebuild:electron && npm run verify:electron-sqlite && electron-builder --win nsis && node scripts/verify-electron-sqlite.cjs --packaged && node scripts/verify-latex.cjs --packaged --smoke",
    "prototype": "npm run dev --workspace @cv-tailor/ui-prototype",
    "prototype:build": "npm run build --workspace @cv-tailor/ui-prototype",
    "prototype:typecheck": "npm run typecheck --workspace @cv-tailor/ui-prototype"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.7",
    "@fontsource-variable/sora": "^5.2.8",
    "@langchain/core": "1.2.19",
    "@langchain/langgraph": "1.5.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "better-sqlite3": "^12.2.0",
    "docx": "^9.13.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "io.cv-tailor.workbench",
    "productName": "CV Tailor",
    "artifactName": "CV-Tailor-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": ".tools/latex",
        "to": "latex"
      },
      {
        "from": "resources/cv-template",
        "to": "cv-template"
      },
      {
        "from": "resources/latex-licenses",
        "to": "licenses/latex"
      },
      {
        "from": "resources/fonts/lato/OFL.txt",
        "to": "licenses/lato-review-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/manrope/LICENSE",
        "to": "licenses/manrope-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/sora/LICENSE",
        "to": "licenses/sora-OFL.txt"
      }
    ]
  }
}
